# 複製為 .env 後填入實際值
SECRET_KEY=請改成一段很長的隨機字串
DATABASE_URL=sqlite:///dailyreport.db

# 驗證模式：ldap（正式，AD 驗證）或 dev（僅限本機開發，任何帳號皆可登入）
AUTH_MODE=ldap

# AD / LDAP 設定：正式環境請在網頁「系統設定 → AD 驗證」設定（存在資料庫）。
# 這裡的值只在資料庫還沒有設定時沿用（舊版安裝、本機開發）。
# 多台網域控制站用 ; 分隔，依序嘗試
LDAP_URL=ldaps://dc01.example.local:636
AD_DOMAIN=example.local
LDAP_BASE_DN=DC=example,DC=local
# 選填：只允許這些群組成員登入（群組 DN，多個用 ; 分隔），留空則所有 AD 帳號皆可登入
LDAP_REQUIRED_GROUP=
# 選填：LDAPS 憑證驗證用的 CA 檔路徑；留空則使用系統預設 CA
LDAP_CA_CERT=
# 選填：這些群組（含巢狀，多個用 ; 分隔）成員首次登入時設為檔案管理員
LDAP_APPROVER_GROUP=
# 選填：以逗號分隔的審核者帳號（sAMAccountName），dev 模式也適用
APPROVER_USERS=

# 截圖存放目錄（預設 instance/uploads）；單次上傳上限 MB（之後以「系統設定 → PDF 與上傳」為準）
UPLOAD_DIR=
MAX_UPLOAD_MB=20

# PDF 輸出：CheckList 範本路徑（預設 instance/templates/checklist.xlsx）與優先使用的字型目錄（預設 instance/fonts）
PDF_TEMPLATE_XLSX=
FONT_DIR=
